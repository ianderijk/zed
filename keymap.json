// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-j": "editor::MoveDown",
      "ctrl-k": "editor::MoveUp",
      "ctrl-u i": "editor::InsertUuidV4",
      "ctrl-d l": "editor::DeleteLine",
      "ctrl-f n": "editor::FindNextMatch",
      "ctrl-j n": "go_to_line::Toggle",
      "ctrl-t e": "terminal_panel::Toggle",
      "ctrl-a k": "workspace::ActivatePaneUp",
      "ctrl-a j": "workspace::ActivatePaneDown",
      "ctrl-a h": "workspace::ActivatePaneLeft",
      "ctrl-a l": "workspace::ActivatePaneRight",
      "ctrl-g": "editor::ScrollCursorCenter",
      "ctrl-k j": [
        "workspace::MoveItemToPaneInDirection",
        {"direction": "down"}
      ],
      "ctrl-k k": [
        "workspace::MoveItemToPaneInDirection",
        {"direction": "up"}
      ],
      "ctrl-k l": [
        "workspace::MoveItemToPaneInDirection",
        {"direction": "right"}
      ],
      "ctrl-k h": [
        "workspace::MoveItemToPaneInDirection",
        {"direction": "left"}
      ],
      "ctrl-i": "editor::Hover",
      "ctrl-n": "editor::GoToNextSymbol",
      "ctrl-m": "editor::GoToPreviousSymbol",
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-a k": "workspace::ActivatePaneUp",
      "ctrl-k k": "terminal::ScrollHalfPageUp",
      "ctrl-j j": "terminal::ScrollHalfPageDown",
      "ctrl-k": "terminal::ScrollHalfPageUp",
      "ctrl-j": "terminal::ScrollHalfPageDown",
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-r": "project_panel::ToggleFocus",
      "ctrl-w": "workspace::ActivatePaneRight",
      "ctrl-d": "project_panel::NewDirectory",
      "ctrl-n": "project_panel::NewFile",
      "ctrl-x": "project_panel::Delete"
    }
  }
]
