{
  // =========================
  // Editor Appearance
  // =========================
  "minimap": {
    "show": "auto"
  },
  "terminal": {
    "show_count_badge": true
  },
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "git_status_indicator": true,
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "inlay_hints": {
    "show_other_hints": false,
    "show_parameter_hints": false,
    "show_type_hints": false,
    "show_value_hints": true,
  },
  "ui_font_size": 16,
  "buffer_font_size": null,

  "buffer_font_features": {
    "calt": true, // ligatures
  },
  "lsp_document_colors": "border",
  "wrap_guides": [79],
  "show_edit_predictions": false,

  // Theme & Colors
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "experimental.theme_overrides": {
    "background.appearance": "transparent",
    "syntax": {
      "keyword": { "color": "#9D70FF" },
      "function": { "color": "#BCBEC4" },
    },
  },

  // =========================
  // Editor Behavior
  // =========================
  "autosave": {
    "after_delay": { "milliseconds": 500 },
  },
  "format_on_save": "off",
  "restore_on_startup": "last_session",
  "show_completions_on_input": true,

  // =========================
  // AI & Assistant Features
  // =========================
  "agent": {
    "dock": "right",
    "play_sound_when_agent_done": "always",
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-thinking",
    },
    "default_model": {
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "claude-haiku-4.5",
    },
  },
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
    "enabled_in_text_threads": false,
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
    },
  },

  // =========================
  // Git Integration
  // =========================
  "git": {
    "inline_blame": { "enabled": false },
  },

  // =========================
  // Language-Specific Settings
  // =========================
  "languages": {
    "Python": {
      "formatter": {
        "external": {
          "command": "uv run ruff format",
        },
      },
      "show_completions_on_input": true,
      "format_on_save": "off",
    },
    // Rust
    "Rust": {
      "formatter": {
        "external": {
          "command": "rustfmt",
          "arguments": [],
        },
      },
      "format_on_save": "on",
    },
  },

  // =========================
  // LSP (Language Server Protocol) for Rust
  // =========================
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy", // rust-analyzer.check.command (default: "check")
        },
        "imports": {
          "merge": { "glob": false },
          "granularity": {
            "enforce": true,
            "group": "module",
          },
        },
        "inlayHints": {
          "maxLength": null,
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true,
          },
          "closureReturnTypeHints": {
            "enable": "always",
          },
        },
      },
    },
  },

  // =========================
  // Privacy & Telemetry
  // =========================
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
}
